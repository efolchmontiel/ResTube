{
  "name": "restube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:yt-dlp": "node scripts/setup-ytdlp.mjs",
    "setup:transcription": "node scripts/setup-transcription.mjs",
    "setup:captions": "node scripts/setup-captions.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.7",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^26.1.0"
  }
}
